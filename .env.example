# ================================
# AI API Keys (Configure at least one)
# ================================

# OpenAI API Key (for GPT models)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic API Key (for Claude models)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# ================================
# LiteLLM Proxy Configuration (Optional)
# ================================

# Use this if you have a self-hosted LiteLLM proxy server
# If set, this will override OpenAI/Anthropic direct API calls
# LITELLM_API_BASE=http://localhost:4000
# LITELLM_API_BASE=https://your-litellm-proxy.com

# API key for your LiteLLM proxy server (if required)
# LITELLM_API_KEY=sk-your-litellm-proxy-key

# ================================
# AI Model Configuration
# ================================

# Model to use for translation
# OpenAI models: gpt-4o, gpt-4o-mini, gpt-4-turbo, gpt-3.5-turbo
# Claude models: claude-3-5-sonnet-20241022, claude-3-opus-20240229, claude-3-sonnet-20240229, claude-3-haiku-20240307
# LiteLLM proxy models: Use model names configured in your proxy (e.g., openai/gpt-4o-mini, anthropic/claude-3-5-sonnet, custom-model-name)
AI_MODEL=gpt-4o-mini

# AI Model parameters
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=2000
AI_TIMEOUT=30

# ================================
# Mattermost Configuration
# ================================

# Incoming Webhook URL (REQUIRED)
# Get this from Mattermost: Main Menu > Integrations > Incoming Webhooks
MATTERMOST_INCOMING_WEBHOOK_URL=https://your-mattermost-server.com/hooks/your-webhook-id

# Bot display name
MATTERMOST_BOT_USERNAME=ai-translator-bot

# Bot icon URL (optional)
MATTERMOST_BOT_ICON_URL=

# ================================
# Ignored Users
# ================================

# Comma-separated list of usernames to ignore (prevent infinite loops)
IGNORED_USERNAMES=ai-translator-bot,mattermost-bot,github,gitlab

# ================================
# Server Configuration
# ================================

SERVER_HOST=0.0.0.0
SERVER_PORT=8000
LOG_LEVEL=INFO

# ================================
# Feature Flags
# ================================

ENABLE_PROFANITY_FILTER=false
PRESERVE_MARKDOWN=true
