# ================================
# LiteLLM Proxy Configuration
# ================================

# LiteLLM Proxy server URL
# Default: http://localhost:4000 (local LiteLLM Proxy)
LITELLM_API_BASE=http://localhost:4000

# API key for LiteLLM Proxy
# Use "dummy-key" for local proxy without authentication
LITELLM_API_KEY=dummy-key

# ================================
# AI Model Configuration
# ================================

# Model name configured in your LiteLLM Proxy
# Default: translator-local (configure this in LiteLLM Proxy config)
# Examples: translator-local, gpt-4o-mini, claude-3-5-sonnet, etc.
AI_MODEL=translator-local

# AI Model parameters
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=2000
AI_TIMEOUT=30

# ================================
# Mattermost Configuration
# ================================

# Incoming Webhook URL (REQUIRED)
# Get this from Mattermost: Main Menu > Integrations > Incoming Webhooks
MATTERMOST_INCOMING_WEBHOOK_URL=https://your-mattermost-server.com/hooks/your-webhook-id

# Bot display name
MATTERMOST_BOT_USERNAME=ai-translator-bot

# Bot icon URL (optional)
MATTERMOST_BOT_ICON_URL=

# ================================
# Mattermost Security (Optional)
# ================================

# Outgoing Webhook Token (for security verification)
# Get this from Mattermost when creating Outgoing Webhook
# Leave empty to disable token verification (not recommended for production)
# MATTERMOST_OUTGOING_TOKEN=your-outgoing-webhook-token-here

# ================================
# Ignored Users
# ================================

# Comma-separated list of usernames to ignore (prevent infinite loops)
IGNORED_USERNAMES=ai-translator-bot,mattermost-bot,github,gitlab

# ================================
# Server Configuration
# ================================

SERVER_HOST=0.0.0.0
SERVER_PORT=8000
LOG_LEVEL=INFO

# ================================
# Feature Flags
# ================================

ENABLE_PROFANITY_FILTER=false
PRESERVE_MARKDOWN=true
